# 本機用 3001。Railway 會自動注入 PORT，請勿在 Railway Variables 手動設定 PORT。
PORT=3001
# 到 https://aistudio.google.com/apikey 建立，只放本機 .env 或 Railway，勿 commit
GEMINI_API_KEY=
# 選填，預設 gemini-2.5-flash（2026/06 勿用 gemini-2.0-flash）
# GEMINI_MODEL=gemini-2.5-flash
# 手機 / 本機前端網址（可多個，逗號分隔）
CORS_ORIGINS=http://localhost:3000,http://192.168.1.157:3000
